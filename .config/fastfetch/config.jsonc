// ~/.config/fastfetch/config.jsonc
// Steins;Gate  //  Future Gadget Lab
// No colors set (terminal theme handles them), logo left on auto-detect.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "height": 19,
  },
  "display": {
    "separator": " ; "
  },
  "modules": [
    {
      "type": "title",
      "format": "Lab Mem 001 ; {user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    { "type": "custom", "format": "──────────────────────────────────" },

    { "type": "os",       "key": "World Line     " },
    { "type": "kernel",   "key": "Attractor Field" },
    { "type": "uptime",   "key": "Time Leap      " },
    { "type": "packages", "key": "Future Gadgets " },
    { "type": "shell",    "key": "D-Mail         " },
    { "type": "wm",       "key": "Gadget Lab     " },
    { "type": "terminal", "key": "PhoneWave      " },
    { "type": "cpu",      "key": "IBN 5100       ", "format": "{name}" },
    { "type": "gpu",      "key": "Nixie Tubes    " },
    { "type": "memory",   "key": "Reading Steiner" },
    { "type": "disk",     "key": "SERN Database  ", "folders": "/" },

    { "type": "custom", "format": "──────────────────────────────────" },
    { "type": "custom", "key": "Divergence     ", "format": "1.048596%" },
    // Want a new world line every launch? Swap the line above for:
    // { "type": "command", "key": "Divergence     ", "text": "awk 'BEGIN{srand(); printf \"%.6f%%\", rand()*2}'" },
    { "type": "custom", "format": "El Psy Kongroo." }
  ]
}
